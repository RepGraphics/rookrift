NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Public legal-page details. Supply a business contact address before commercial launch.
LEGAL_OPERATOR_NAME=Euphoria Development
LEGAL_CONTACT_EMAIL=support@euphoriadevelopment.uk
LEGAL_COUNTRY=United Kingdom
LEGAL_BUSINESS_ADDRESS=
# Production: paste Dokploy's INTERNAL PostgreSQL URL (URL-encode password characters).
DATABASE_URL=
PG_POOL_MAX=10
# Compose stack credentials. Use strong unique values; never commit .env.
POSTGRES_PASSWORD=
# Redis is optional. Leave REDIS_URL empty to read chart aggregates directly from PostgreSQL.
REDIS_URL=
REDIS_PASSWORD=
# Optional log bridge. The host path is a DIRECTORY mounted read-only at /logs.
# Native RCON linking works without this bridge. Controller extensions use the
# per-server token returned by POST /api/servers/{server_id}/link-agent.
LINK_LOG_HOST_PATH=
LINK_LOG_PATH=/logs/server.log
ROOKRIFT_LINK_ENDPOINT=http://rookrift:3000/api/link-events
ROOKRIFT_LINK_TOKEN=
ROOKRIFT_SERVER_ID=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
# Optional SMTP for password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional development guild for instant command registration
DISCORD_DEV_GUILD_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Separate Stripe Connect integration for community store payments
# Connect-account events -> /api/webhooks/community-stripe
STRIPE_CONNECT_SECRET_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_TRIBE_MONTHLY_PRICE_ID=
STRIPE_CLUSTER_MONTHLY_PRICE_ID=
# Optional: keep old subscription price IDs entitled during a price migration.
STRIPE_TRIBE_LEGACY_MONTHLY_PRICE_IDS=
STRIPE_CLUSTER_LEGACY_MONTHLY_PRICE_IDS=
# Exact reverse-proxy hop count; leave zero for a direct connection
TRUST_PROXY_HOPS=0
# Opt in only on a trusted private network; default blocks private RCON targets
ALLOW_PRIVATE_RCON=false
# Separate opt-in for verified-HTTPS Pterodactyl panels on trusted private networks
ALLOW_PRIVATE_HOSTING=false
