NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATABASE_PATH=./data/rookrift.sqlite
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
# Optional development guild for instant command registration
DISCORD_DEV_GUILD_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TRIBE_MONTHLY_PRICE_ID=
STRIPE_CLUSTER_MONTHLY_PRICE_ID=
# Optional: keep old subscription price IDs entitled during a price migration.
STRIPE_TRIBE_LEGACY_MONTHLY_PRICE_IDS=
STRIPE_CLUSTER_LEGACY_MONTHLY_PRICE_IDS=
# Exact reverse-proxy hop count; leave zero for a direct connection
TRUST_PROXY_HOPS=0
# Opt in only on a trusted private network; default blocks private RCON targets
ALLOW_PRIVATE_RCON=false
# Separate opt-in for verified-HTTPS Pterodactyl panels on trusted private networks
ALLOW_PRIVATE_HOSTING=false
